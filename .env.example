# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
MAIL_TODO_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# PostgreSQL — source of truth for runs, schedules, results and outbox
DATABASE_URL=postgresql://mail_todo:change-me@localhost:5432/mail_todo
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Durable queue
QUEUE_URL=redis://localhost:6379/0
QUEUE_NAME=mail-todo
QUEUE_MAX_RETRIES=3

# Gmail OAuth 2.0 (read-only scope only)
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/v1/mail-todo/oauth/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_CONNECTION_DB_PATH=.data/mail_todo.db
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_SECRET=replace-with-a-random-state-signing-secret
# Localhost only; remove this variable in production (HTTPS).
OAUTHLIB_INSECURE_TRANSPORT=1

# Token encryption — use KMS/envelope encryption in production
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
KMS_KEY_ID=

# LLM provider: gemini or groq
LLM_PROVIDER=gemini

# Gemini action extractor
GEMINI_API_KEY_1=replace-with-gemini-api-key-1
GEMINI_API_KEY_2=replace-with-gemini-api-key-2
GEMINI_API_KEY_3=replace-with-gemini-api-key-3
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_KEY_ROTATION_STRATEGY=round_robin
GEMINI_ROTATE_ON_RATE_LIMIT=true
GEMINI_MAX_ATTEMPTS_PER_REQUEST=3
GEMINI_MAX_EMAILS_PER_BATCH=5
GEMINI_MAX_INPUT_TOKENS=40000
GEMINI_TIMEOUT_SECONDS=60

# Groq action extractor (set LLM_PROVIDER=groq to enable)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_EMAILS_PER_BATCH=5
GROQ_TIMEOUT_SECONDS=60

STREAMLIT_POLL_INTERVAL_SECONDS=1.5
STREAMLIT_POLL_BUFFER_SECONDS=30

# Run and mailbox limits
MAIL_TODO_DEFAULT_QUERY=is:unread in:inbox
MAIL_TODO_MAX_EMAILS=200
MAIL_TODO_FETCH_CONCURRENCY=5
MAIL_TODO_DEDUPE_WINDOW_DAYS=30

# Attachment extraction limits
ATTACHMENT_EXTRACTOR_URL=http://localhost:8081
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_TOTAL_BYTES_PER_EMAIL=26214400
ATTACHMENT_MAX_UNITS=100
ATTACHMENT_MAX_CHARACTERS=200000
ATTACHMENT_TIMEOUT_SECONDS=60
ATTACHMENT_MEMORY_LIMIT_MB=512
ANTIVIRUS_URL=

# Scheduler and outbox
SCHEDULER_MISFIRE_WINDOW_HOURS=6
OUTBOX_POLL_INTERVAL_SECONDS=5

# Privacy: raw email bodies and attachments must not be logged or persisted
RAW_CONTENT_TTL_SECONDS=0
