# ------------------------------------------------------------------
# SECRETS TEMPLATE (.env.example)
# Copy this file to .env and fill in the secrets for your environment.
#
# NOTE: Non-secret shared configurations and feature flags are located
# in the git-tracked `config` file. Keep credentials, API keys, passwords,
# and private tokens in .env only (never commit .env).
# ------------------------------------------------------------------

# Gmail OAuth 2.0 Credentials & Account
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
GMAIL_ACCOUNT_EMAIL=replace-with-gmail-account-email

# Optional Outlook / Microsoft 365 delegated OAuth (SQLite mode only)
# Register this callback in the Microsoft app:
# http://localhost:8000/v1/mail-todo/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/mail-todo/oauth/outlook/callback
MICROSOFT_SCOPES=openid profile email offline_access https://graph.microsoft.com/Mail.Read

# Local Security Keys
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
OAUTH_STATE_SECRET=replace-with-a-random-state-signing-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-fernet-key

# Gemini API Keys (Key Rotation: GEMINI_API_KEY_1..6)
GEMINI_API_KEY_1=replace-with-gemini-api-key-1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# Jina API Keys (Key Rotation: JINA_API_KEY..5)
JINA_API_KEY=replace-with-jina-api-key
JINA_API_KEY2=
JINA_API_KEY3=
JINA_API_KEY4=
JINA_API_KEY5=

# Cohere API Keys (Key Rotation: COHERE_API_KEY..8)
COHERE_API_KEY=replace-with-cohere-api-key
COHERE_API_KEY2=
COHERE_API_KEY3=
COHERE_API_KEY4=
COHERE_API_KEY5=
COHERE_API_KEY6=
COHERE_API_KEY7=
COHERE_API_KEY8=

# OpenRouter API Key
OPENROUTER_API_KEY=replace-with-openrouter-api-key

# Groq API Key
GROQ_API_KEY=replace-with-groq-api-key

# Mistral API Key (Chat / Ingestion / OCR)
MISTRAL_API_KEY=replace-with-mistral-api-key

# Vector DB Credentials
QDRANT_API_KEY=replace-with-qdrant-api-key

# Supabase Auth Keys
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Database Connection URLs (contain passwords)
DATABASE_URL_LOCAL=postgresql://cowork:cowork_dev_only@127.0.0.1:5432/cowork
DATABASE_URL_CLOUD=postgresql://postgres.project-ref:replace-with-password@aws-region.pooler.supabase.com:5432/postgres?sslmode=require

# Langfuse Observability Credentials
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
