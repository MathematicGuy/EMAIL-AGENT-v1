# ------------------------------------------------------------------
# CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in the values for your environment.
# ------------------------------------------------------------------

# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_WORKERS=1
APP_HOST=127.0.0.1
APP_PORT=8000
APP_HOST_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
MAIL_TODO_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Gmail OAuth 2.0 (read-only scope only)
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/v1/mail-todo/oauth/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_CONNECTION_DB_PATH=.data/mail_todo.db
OAUTH_STATE_TTL_SECONDS=600
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
GMAIL_ACCOUNT_EMAIL=replace-with-gmail-account-email

# Local Security Secrets
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
OAUTH_STATE_SECRET=replace-with-a-random-state-signing-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-fernet-key

# Localhost OAuth transport flag (remove in production when using HTTPS)
OAUTHLIB_INSECURE_TRANSPORT=1

# LLM Provider: gemini | groq | faucet
LLM_PROVIDER=gemini

# Gemini Action Extractor & Key Rotation (active when LLM_PROVIDER=gemini)
GEMINI_API_KEY_1=replace-with-gemini-api-key-1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_KEY_ROTATION_STRATEGY=round_robin
GEMINI_ROTATE_ON_RATE_LIMIT=true
GEMINI_MAX_ATTEMPTS_PER_REQUEST=3
GEMINI_MAX_EMAILS_PER_BATCH=5
GEMINI_MAX_INPUT_TOKENS=40000
GEMINI_TIMEOUT_SECONDS=60

# Generic / Project-document embeddings
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
EMBEDDING_DIMENSIONS=1024
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=3072
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_BATCH_SIZE=100

# Cohere Reranker (Key Rotation: COHERE_API_KEY..8)
RERANKER_MODEL=rerank-v4.0-fast
RERANKER_ROTATE_ON_RATE_LIMIT=true
RERANKER_TIMEOUT_SECONDS=10

# Jina Embeddings (with Key Rotation & Token Exhaustion Eviction)
JINA_API_KEY=replace-with-jina-api-key
JINA_API_KEY2=
JINA_API_KEY3=
JINA_API_KEY4=
JINA_API_KEY5=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
JINA_EMBEDDING_DIMENSIONS=1024
JINA_EMBEDDING_TIMEOUT_SECONDS=30
JINA_EMBEDDING_ROTATE_ON_RATE_LIMIT=true

# Cohere (Reranker with Key Rotation)
COHERE_API_KEY=replace-with-cohere-api-key
COHERE_API_KEY2=
COHERE_API_KEY3=
COHERE_API_KEY4=
COHERE_API_KEY5=
COHERE_API_KEY6=
COHERE_API_KEY7=
COHERE_API_KEY8=

# AI Judge Model (OpenRouter for evaluations / LLM-as-a-judge)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_ALLOWED_MODELS=["openai/gpt-5.6-luna", "deepseek/deepseek-v4-flash"]

# Groq (active when LLM_PROVIDER=groq)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_EMAILS_PER_BATCH=5
GROQ_TIMEOUT_SECONDS=60

# Faucet (active when LLM_PROVIDER=faucet)
FAUCET_API_KEY=replace-with-faucet-api-key
FAUCET_MODEL=deepseek-v4-flash
FAUCET_MAX_EMAILS_PER_BATCH=5
FAUCET_MAX_OUTPUT_TOKENS=2048
FAUCET_TIMEOUT_SECONDS=60

# Company RAG store (turbovec = in-process 4-bit hybrid). qdrant is retired.
RAG_STORE_PROVIDER=turbovec

# Supabase Managed PostgreSQL & Private Storage
# Persistent FastAPI: Shared session :5432 (this default) or Direct db.<ref>:5432.
# Do not use Shared transaction :6543 here — that mode is for serverless.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=documents

# Session & Chat Memory (V2)
APP_SESSION_TTL_SECONDS=2592000
APP_SESSION_COOKIE_NAME=cowork_session
APP_SESSION_COOKIE_SECURE=true
CHAT_MEMORY_MAX_TURNS=20
CHAT_MEMORY_TTL_SECONDS=1800
CHAT_PROFILE_RETENTION_SECONDS=7776000
CHAT_EPISODE_RETENTION_SECONDS=7776000

# AI Chat Intent Routing & Document Tools
CHAT_INTENT_CLASSIFIER_MODEL=
CHAT_INTENT_CLASSIFIER_TIMEOUT_MS=10000

# User Project Documents & Knowledge Ingestion
# Local cache for per-project Turbovec .tvim files (ADR-008). Durable copy is in Storage.
USER_DOCUMENTS_INDEX_ROOT=var/project-indexes
USER_DOCUMENTS_MAX_FILE_BYTES=26214400
USER_DOCUMENTS_MAX_PAGES=100
USER_DOCUMENTS_MAX_DOCUMENTS_PER_PROJECT=50
USER_DOCUMENTS_MAX_PROJECT_BYTES=524288000
USER_DOCUMENTS_RETENTION_DAYS=30
USER_DOCUMENTS_TOP_K=8
USER_DOCUMENTS_MIN_SCORE=0.6
USER_DOCUMENTS_RETRIEVAL_TIMEOUT_MS=10000
# Knowledge Extraction Mode: basic (offline local extraction) | advance (Mistral OCR)
EXTRACTION_MODE=basic
MISTRAL_API_KEY=replace-with-mistral-api-key

# Evaluation Launch Thresholds (required by scripts/run_paired_chat_evaluation.py)
EVAL_MIN_CONTINUITY_DELTA=0.05
EVAL_MIN_GROUNDED_DELTA=0.05
EVAL_MIN_CITATION_DELTA=0.05
EVAL_MIN_CONTINUITY_SCORE=0.6
EVAL_MIN_GROUNDED_SCORE=0.6
EVAL_MIN_CITATION_SCORE=0.6
EVAL_MAX_DEGRADATION_RATE=0.25

# Observability & Tracing (Langfuse)
LANGFUSE_DEBUG=true
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
