# ------------------------------------------------------------------
# CURRENT IMPLEMENTATION (local MVP)
# The runtime reads exactly the variables below. PostgreSQL, durable
# queue, scheduler, outbox, and attachment-extractor services belong to
# the target architecture and are NOT implemented yet — see
# docs/master-comparison.md.
# ------------------------------------------------------------------

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Optional browser destination after Gmail OAuth completes.
FRONTEND_URL=http://localhost:5173

# LLM provider: gemini, groq, or faucet
LLM_PROVIDER=gemini

# Gmail OAuth 2.0 (read-only scope only)
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/v1/mail-todo/oauth/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_CONNECTION_DB_PATH=.data/mail_todo.db
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_SECRET=replace-with-a-random-state-signing-secret
# Localhost only; remove this variable in production (HTTPS).
# Consumed by google-auth-oauthlib, not by application code.
OAUTHLIB_INSECURE_TRANSPORT=1

# Token encryption — use KMS/envelope encryption in production
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Supabase managed PostgreSQL. Use the SSL URI from the Supabase Dashboard;
# this server is the only client that receives it.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-region.pooler.supabase.com:6543/postgres?sslmode=require

# Opaque FastAPI application session after Gmail OAuth. Keep Secure=true in
# production; set false only for local HTTP development.
APP_SESSION_TTL_SECONDS=2592000
APP_SESSION_COOKIE_NAME=cowork_session
APP_SESSION_COOKIE_SECURE=true

# Gemini (active when LLM_PROVIDER=gemini; at least one key required)
GEMINI_API_KEY_1=replace-with-gemini-api-key-1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_KEY_ROTATION_STRATEGY=round_robin
GEMINI_ROTATE_ON_RATE_LIMIT=true
GEMINI_MAX_ATTEMPTS_PER_REQUEST=3
GEMINI_MAX_EMAILS_PER_BATCH=5
GEMINI_MAX_INPUT_TOKENS=40000
GEMINI_TIMEOUT_SECONDS=60

# Optional local hybrid-RAG reranking. Blank or any Jina failure preserves RRF order.
JINA_API_KEY=

# Vector Store (Qdrant Cloud)
QDRANT_URL=replace-with-qdrant-cloud-url
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key
QDRANT_COLLECTION=company_knowledge
QDRANT_ENABLED=false
QDRANT_VECTOR_SIZE=768
QDRANT_REINDEX=false

# Optional durable AI Chat retention in seconds. Leave blank for no server default.
CHAT_PROFILE_RETENTION_SECONDS=7776000
CHAT_EPISODE_RETENTION_SECONDS=7776000

# Groq (active when LLM_PROVIDER=groq)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_EMAILS_PER_BATCH=5
GROQ_TIMEOUT_SECONDS=60

# Faucet (active when LLM_PROVIDER=faucet; OpenAI-compatible HTTPS endpoint is fixed in code)
FAUCET_API_KEY=replace-with-faucet-api-key
FAUCET_MODEL=replace-with-faucet-model
FAUCET_MAX_EMAILS_PER_BATCH=5
FAUCET_MAX_OUTPUT_TOKENS=2048
FAUCET_TIMEOUT_SECONDS=60

# Streamlit GUI only (scripts/run_gui.py)
APP_HOST_URL=http://localhost:8000
STREAMLIT_POLL_INTERVAL_SECONDS=1.5
STREAMLIT_POLL_BUFFER_SECONDS=30

# Paired evaluation launch thresholds — product-owner approved 2026-08-11 (Moderate MVP).
# All seven variables must be set simultaneously; any missing or unparsable value
# causes the CLI runner to refuse (fail-closed, no numeric defaults).
EVAL_MIN_CONTINUITY_DELTA=0.05
EVAL_MIN_GROUNDED_DELTA=0.05
EVAL_MIN_CITATION_DELTA=0.05
EVAL_MIN_CONTINUITY_SCORE=0.6
EVAL_MIN_GROUNDED_SCORE=0.6
EVAL_MIN_CITATION_SCORE=0.6
EVAL_MAX_DEGRADATION_RATE=0.25
